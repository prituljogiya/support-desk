# Database — PostgreSQL (required for Vercel / production)
# Local: Neon free tier, Supabase, Docker, or Vercel Postgres
# Example Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/support_desk?sslmode=require"

# Auth.js / NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-string"

# Freshdesk REST API v2 (optional global fallback — prefer org settings in Admin)
# Domain can be "yourcompany" or "yourcompany.freshdesk.com"
FRESHDESK_DOMAIN=""
FRESHDESK_API_KEY=""
# Optional: shared secret for POST /api/webhooks/freshdesk
# Send as header x-freshdesk-webhook-secret or Authorization: Bearer <secret>
# Per-org: pass x-organization-slug or ?org=<slug> and use org webhook secret
FRESHDESK_WEBHOOK_SECRET=""

# Optional: protect /api/sync/retry with Authorization: Bearer <secret>
CRON_SECRET=""

# Stripe (optional — without these, owners/super-admins assign plans manually)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
STRIPE_WEBHOOK_SECRET=""

# Optional: AI reply draft (falls back to keyword suggest without this)
OPENAI_API_KEY=""
